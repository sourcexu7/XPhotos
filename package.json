{
  "name": "xphotos",
  "version": "1.0.0",
  "private": true,
  "description": "XPhotos — 现代化摄影图库，基于 Next.js 15、React 19 和 Ant Design",
  "author": "Bess Croft <besscroft@foxmail.com>",
  "license": "MIT",
  "packageManager": "pnpm@9.7.1",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:server": "pnpm run dev:prisma && pnpm run prisma:seed && next dev",
    "dev:turbopack": "pnpm run dev:prisma && pnpm run prisma:seed && next dev --turbopack",
    "dev:prisma": "pnpm run prisma:dev && pnpm run prisma:generate",
    "build": "next build",
    "vercel-build": "pnpm run prisma:generate && next build",
    "build:analyzer": "ANALYZE=true next build",
    "build:vercel": "pnpm run prisma:deploy && pnpm run prisma:generate && pnpm run prisma:seed && next build",
    "build:netlify": "pnpm run prisma:deploy && pnpm run prisma:generate && pnpm run prisma:seed && next build",
    "build:node": "pnpm run prisma:deploy && pnpm run prisma:generate && next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "eslint --fix \"**/*.{ts,tsx,js,jsx}\" --ignore-pattern \"components/ui/*.{tsx}\" --ignore-pattern \"node_modules\" --ignore-pattern \".next\"",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "prisma:format": "prisma format",
    "prisma:generate": "prisma generate",
    "prisma:dev": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "prisma db seed",
    "prisma:studio": "prisma studio"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@ant-design/icons": "^6.1.0",
    "@aws-sdk/client-s3": "3.873.0",
    "@aws-sdk/s3-request-presigner": "3.873.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@paralleldrive/cuid2": "2.2.2",
    "@prisma/client": "6.4.1",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-icons": "1.3.2",
    "@radix-ui/react-slot": "1.2.3",
    "antd": "^6.6.2",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "compressorjs": "1.2.1",
    "dayjs": "1.11.13",
    "emblor": "1.4.8",
    "exifreader": "4.31.0",
    "heic-to": "1.2.2",
    "hono": "4.9.4",
    "jose": "^6.1.3",
    "livephotoskit": "1.5.6",
    "lucide-react": "0.541.0",
    "motion": "^12.23.26",
    "next": "15.5.7",
    "next-intl": "4.3.5",
    "next-nprogress-bar": "2.4.7",
    "next-pwa": "5.6.0",
    "next-qrcode": "2.5.1",
    "next-themes": "0.4.6",
    "piexifjs": "^1.0.6",
    "react": "19.1.2",
    "react-dom": "19.1.2",
    "react-photo-album": "3.1.0",
    "react-window": "^1.8.11",
    "recharts": "3.1.2",
    "redis": "^5.11.0",
    "rss": "1.2.2",
    "server-only": "0.0.1",
    "sharp": "0.34.3",
    "sonner": "2.0.7",
    "swr": "2.3.6",
    "tailwind-merge": "3.3.1",
    "thumbhash": "^0.1.1",
    "tw-animate-css": "1.3.7",
    "yet-another-react-lightbox": "3.25.0",
    "zod": "4.0.17",
    "zustand": "5.0.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@next/bundle-analyzer": "15.5.7",
    "@next/eslint-plugin-next": "15.5.7",
    "@stagewise/toolbar": "^0.6.3",
    "@tailwindcss/postcss": "4.1.12",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "20.17.19",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "@types/rss": "0.0.32",
    "eslint": "9.33.0",
    "eslint-config-next": "15.5.3",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.6.2",
    "prisma": "6.4.1",
    "tailwindcss": "4.1.12",
    "tsx": "^4.21.0",
    "typescript": "5.9.2"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.1.13",
      "@types/react-dom": "19.1.9"
    }
  }
}
